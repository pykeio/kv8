From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Fix Rust deprecation warnings

---

diff --git a/src/isolate.rs b/src/isolate.rs
index 03a76f3..e58669f 100644
--- a/src/isolate.rs
+++ b/src/isolate.rs
@@ -2333,7 +2333,7 @@ fn current_thread_id() -> usize {
     // from another TLS destructor, where panicking would abort the process.
     // A relaxed global counter is sufficient because IDs are only compared.
     let id = NEXT_THREAD_ID
-      .fetch_update(
+      .try_update(
         std::sync::atomic::Ordering::Relaxed,
         std::sync::atomic::Ordering::Relaxed,
         |next| next.checked_add(1),
